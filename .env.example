# Supabase Connection
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL="your_supabase_project_url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Per-instance pool bounds, not a promise of available database capacity.
# With Supabase transaction pooling use the port shown by the dashboard (often6543).
DB_POOL_MAX=6
DB_IDLE_TIMEOUT_SECONDS=20
DB_CONNECT_TIMEOUT_SECONDS=10
# Set statement_timeout on the dedicated application DB role if required.
# The limiter uses one autocommit query to release shared-IP locks promptly.

# Student access codes still use a dedicated server-only signing secret.
STUDENT_AUTH_SECRET="replace_with_a_different_random_secret_of_at_least_32_characters"

# Server-only username aliases mapped to existing Supabase Auth email accounts.
# Example: {"UserDirector":"director@your-school.example"}; no passwords here.
STAFF_LOGIN_ALIASES='{}'

# GPT: server-only key from https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"
